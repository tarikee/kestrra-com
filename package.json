{
  "name": "kestrra-com",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "assets": "bun run pipeline/build-assets.ts",
    "assets:verify": "bun run pipeline/verify-roundtrip.ts",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "lenis": "^1.3.26",
    "motion": "^12.23.0",
    "mp4-muxer": "^5.2.2",
    "next": "^15.5.0",
    "next-view-transitions": "^0.3.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "exif-reader": "^2.0.2",
    "sharp": "^0.34.0",
    "tailwindcss": "^4.1.0",
    "thumbhash": "^0.1.1",
    "typescript": "^5.8.0",
    "wrangler": "^4.121.0"
  }
}
