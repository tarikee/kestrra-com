# Static files are served straight from Cloudflare's asset store, before the
# Worker, so their headers live here (pages get theirs from next.config.ts).

/*
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN

/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# image paths keep their names when a frame is re-exported, so a month rather
# than forever
/img/*
  Cache-Control: public, max-age=2592000

/brand/*
  Cache-Control: public, max-age=604800

/og.jpg
  Cache-Control: public, max-age=86400
