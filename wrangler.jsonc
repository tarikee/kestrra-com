{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kestrra-com",
  "main": ".open-next/worker.js",
  // the newest date this wrangler's workerd supports; "today" is a day ahead
  // of the binary and refuses to boot locally
  "compatibility_date": "2026-08-11",
  "compatibility_flags": ["nodejs_compat"],

  // The 139 prerendered pages and every image derivative are served straight
  // from static assets — free, unmetered, and never touched by the Worker.
  // Only the inquiry action costs a request.
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  // ⚠️ Two hostnames, both exact. NEVER a wildcard.
  //
  // kestrra.com carries a private subdomain used for tunnelling. A route of
  // `*.kestrra.com/*`, or any wildcard on this zone, would put this Worker in
  // front of that tunnel and silently break it — and the breakage would be
  // invisible from this site's own QA. Widening this list is not a small edit.
  "routes": [
    { "pattern": "kestrra.com", "custom_domain": true },
    { "pattern": "www.kestrra.com", "custom_domain": true }
  ],

  // The inquiry form's transport. Email Routing is free and unmetered, and a
  // send to a *verified destination address* on the account is free too — it
  // does not touch the Email Sending quota, which is a paid product. That is
  // the whole reason the destination is pinned here rather than left open:
  // `destination_address` restricts this binding to the one verified inbox,
  // so the Worker cannot be turned into a relay, and cannot cost anything.
  //
  // Requires, on the Cloudflare account: Email Routing enabled on kestrra.com
  // (MX + SPF at the apex — never on the tunnel subdomain), and INQUIRY_TO
  // added and verified under Email Routing → Destination Addresses.
  "send_email": [
    {
      "name": "SEND_EMAIL",
      "destination_address": "kestrraa@gmail.com"
    }
  ],

  // where inquiries land. Not a secret — it is a destination the binding is
  // already pinned to — so it lives here and stays visible in review.
  "vars": {
    "INQUIRY_TO": "kestrraa@gmail.com"
  },

  "workers_dev": true,

  "observability": {
    "enabled": true
  }
}
