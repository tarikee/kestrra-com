{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kestrra-com",
  "main": ".open-next/worker.js",
  // the newest date this wrangler's workerd supports; "today" is a day ahead
  // of the binary and refuses to boot locally
  "compatibility_date": "2026-08-11",
  "compatibility_flags": ["nodejs_compat"],

  // The 139 prerendered pages and every image derivative are served straight
  // from static assets — free, unmetered, and never touched by the Worker.
  // Only the inquiry action costs a request.
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  // ⚠️ Two hostnames, both exact. NEVER a wildcard.
  //
  // kestrra.com carries a private subdomain used for tunnelling. A route of
  // `*.kestrra.com/*`, or any wildcard on this zone, would put this Worker in
  // front of that tunnel and silently break it — and the breakage would be
  // invisible from this site's own QA. Widening this list is not a small edit.
  "routes": [
    { "pattern": "kestrra.com", "custom_domain": true },
    { "pattern": "www.kestrra.com", "custom_domain": true }
  ],

  "workers_dev": true,

  "observability": {
    "enabled": true
  }
}
